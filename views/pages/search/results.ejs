<!DOCTYPE html>
<html lang="vi">

<head>
	<meta charset="UTF-8">
	<meta name="theme-color" content="#2a7ee4">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="author" content="IE104.O12_Nhom2">
	<meta name="description" content="Tất cả sản phẩm được bày bán ở Mayor Wolf luôn được đảm bảo về nguồn gốc và chất lượng.">

	<link rel="shortcut icon" type="image/x-icon" href="/imgs/ico-logo-blue.png">
	<link rel="stylesheet" href="/styles/pages/search/results.css">

	<title>Mayor Wolf. Kết quả tìm kiếm</title>
</head>

<body>
	<%- include('../../partials/header', { header: header, user: user }) %>

	<main class="seacrh-result__container">
		<!-- ❌ XÓA TOÀN BỘ PHẦN BỘ LỌC -->

		<div class="seacrh-result__heading--disable">
			<p class="seacrh-result__sort--disable">Nổi bật</p>
			<p class="seacrh-result__sort--disable">Bán chạy</p>
			<p class="seacrh-result__sort--disable">
				Giá <span class="material-symbols-outlined">swap_vert</span>
			</p>
			<span class="material-symbols-outlined" id="btn-filter">filter_alt</span>
		</div>

		<section class="seacrh-result__main">
			<div class="seacrh-result__main__heading">
				<% if (productListResults.totalRow > 0) { %>
				<p class="seacrh-result__main__count">
					Tìm thấy
					<span class="seacrh-result__highlight"><%= productListResults.totalRow %></span> kết quả cho từ khóa "
					<span class="seacrh-result__key"><%= productListResults.searchKey ?? productListResults.category_name %></span>"
				</p>
				<% } else { %>
				<p class="seacrh-result__main__count">
					Tìm thấy
					<span class="seacrh-result__highlight"><%= productListResults.totalRow %></span>
					kết quả
				</p>
				<% } %>
				
				<div class="seacrh-result__sort">
					<p class="seacrh-result__sort-title">Sắp xếp theo:</p>
					<div class="seacrh-result__sort-content">
						<p>Nổi bật</p>
						<span class="material-symbols-outlined">expand_more</span>
					</div>
					<div class="dropdown-content--sort">
						<div class="dropdown-options">
							<input class="sort-option" type="radio" id="hot" name="sort" value="hot">
							<label for="hot" class="sort-label">Nổi bật</label>
						</div>
						<hr>
						<div class="dropdown-options">
							<input class="sort-option" type="radio" id="sale" name="sort" value="sale">
							<label for="sale" class="sort-label">Bán chạy</label>
						</div>
						<hr>
						<div class="dropdown-options">
							<input class="sort-option" type="radio" id="price-z-to-a" name="sort" value="price-z-to-a">
							<label for="price-z-to-a" class="sort-label">Giá cao đến thấp</label>
						</div>
						<hr>
						<div class="dropdown-options">
							<input class="sort-option" type="radio" id="price-a-to-z" name="sort" value="price-a-to-z">
							<label for="price-a-to-z" class="sort-label">Giá thấp đến cao</label>
						</div>
					</div>
				</div>
			</div>

			<% if (productListResults.totalRow > 0) { %>
			<div class="seacrh-result__main-card">
				<% productListResults.products.slice().forEach(product => { %>
				<%- include('../../components/product-card', {product: product, toCurrency: formatFunction.toCurrency}) %>
				<% }) %>
				<%- include('../../components/pagination', {pagination: productListResults}) %>
			</div>
			<% } else { %>
			<div class="search-results--empty">
				<img src="/imgs/search-result--empty.png" alt="empty">
			</div>
			<% } %>
		</section>
	</main>

	<%- include('../../components/scrollup') %>
	<%- include('../../partials/footer') %> <%- include('../../partials/app-bar') %>

	<script src="/scripts/pages/search/results.js"></script>
	<script src="/scripts/components/scrollup.js"></script>
	<script src="/scripts/partials/header.js"></script>

</body>

</html>